 const yaml = require('js-yaml');
 
+// js-yaml 4 replaced safeLoad/safeDump with stubs that THROW ("removed in js-yaml 4");
+// its load/dump are safe by default. js-yaml 3 has the real safeLoad/safeDump. Probe once
+// which API actually works (a bare `safeLoad || load` fails — the 4.x stub is truthy), so
+// gray-matter parses safely on EITHER major and a security override can bump js-yaml 3→4.
+let yamlSafeParse, yamlSafeStringify;
+try {
+  yaml.safeLoad(''); // 3.x: returns undefined · 4.x: throws
+  yamlSafeParse = yaml.safeLoad.bind(yaml);
+  yamlSafeStringify = yaml.safeDump.bind(yaml);
+} catch (err) {
+  yamlSafeParse = yaml.load.bind(yaml);
+  yamlSafeStringify = yaml.dump.bind(yaml);
+}
+
 /**
  * Default engines
  */
@@ -13,8 +27,8 @@ const engines = exports = module.exports;
