    "@vercel/blob": "^2.4.0",
    "@vercel/config": "^0.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.191",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-email": "^5.2.10",
